---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Isobars from "@/components/Isobars.astro";
import ProfileLinks from "@/components/ProfileLinks.astro";
import { monthYear, newestFirst } from "@/utils/cv";

// Drop a portrait at src/assets/images/portrait.{jpg,png,webp} and it shows up in the hero.
const portraits = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/portrait.{jpg,jpeg,png,webp}",
  { eager: true }
);
const portrait = Object.values(portraits)[0]?.default;

const byStartDesc = newestFirst<{ data: { startDate: Date } }>(
  e => e.data.startDate
);

const work = await getCollection("work");
const education = await getCollection("education");
const news = (await getCollection("news")).sort(newestFirst(e => e.data.date));

// Anything in the CV without an end date is ongoing
const current = [
  ...work
    .filter(({ data }) => !data.endDate)
    .sort(byStartDesc)
    .map(({ data }) => ({
      title: data.role,
      place: data.name,
      since: data.startDate,
    })),
  ...education
    .filter(({ data }) => !data.endDate)
    .sort(byStartDesc)
    .map(({ data }) => ({
      title: data.degree,
      place: data.institution,
      since: data.startDate,
    })),
];

const year = (date: Date) => date.getFullYear();
---

<Layout>
  <Header />
  <main id="main-content" class="app-layout pb-16">
    <section
      id="hero"
      class="relative isolate overflow-hidden border border-edge bg-surface"
    >
      <Isobars class="chart absolute inset-0 -z-10" />

      <div
        class="grid gap-8 px-6 py-10 sm:px-10 sm:py-14 md:grid-cols-[auto_1fr] md:items-end md:gap-10"
      >
        {
          portrait ? (
            <Image
              src={portrait}
              alt="Thanasis Georgiou"
              width={176}
              height={176}
              class="size-32 border border-edge object-cover sm:size-44"
              loading="eager"
            />
          ) : (
            import.meta.env.DEV && (
              <div class="grid size-32 place-content-center border border-dashed border-edge p-3 text-center text-xs break-all text-subtle sm:size-44">
                src/assets/images/portrait.jpg
              </div>
            )
          )
        }

        <div class="max-w-xl">
          <h1
            class="text-[clamp(2.5rem,8vw,4.5rem)] leading-[0.95] font-medium tracking-[-0.04em]"
          >
            Thanasis<br />Georgiou
          </h1>
          <p class="mt-5 text-lg leading-snug text-balance sm:text-xl">
            Researcher in data assimilation and atmospheric composition at the
            National Observatory of Athens.
          </p>
          <ProfileLinks class="mt-6" />
        </div>
      </div>
    </section>

    <div class="mt-14 grid gap-12 md:grid-cols-[minmax(0,1fr)_17rem] md:gap-14">
      <section id="about" class="max-w-[62ch]">
        <h2 class="text-xl font-medium tracking-tight">About</h2>
        <div class="mt-4 space-y-4 text-[1.0625rem] leading-relaxed">
          <p>
            Hi! I'm Thanasis, an atmospheric scientist based in Athens. I work
            on atmospheric composition and numerical weather prediction, and
            more specifically on data assimilation: combining observations from
            new satellite instruments (EarthCARE, PACE, Aeolus) with models to
            get the best possible picture of aerosols in the atmosphere.
          </p>

          <p>
            I'm a PhD candidate working at the National Observatory of Athens.
            Before that, I spent five years as a software engineer in the same
            group, where I ran our HPC cluster, built a global aerosol
            climatology and developed a platform to manage observations for the
            PANGEA climate observatory on Antikythera. Somewhere along the line
            I got to know the atmosphere well enough to want to study it
            properly, so I switched to research. Old habits die hard, so I still
            look after the cluster. These days I also help supervise some of our
            newer PhD students.
          </p>

          <p>
            Outside of work, <a
              href="https://www.instagram.com/thanasis.georgiou">I shoot film</a
            >, collect and fix old cameras, and tinker with 3D printing and
            electronics, which occasionally meet in the middle. I also love
            hiking and on occasion dabble in observational astronomy. Some
            webdev is sprinkled in here from time to time.
          </p>

          <p>
            <a
              href="/cv"
              class="font-medium text-accent-ink underline decoration-1 underline-offset-4 hover:decoration-2"
            >
              Read the full CV
            </a>
          </p>
        </div>
      </section>

      <aside class="space-y-10">
        {
          current.length > 0 && (
            <section id="currently">
              <h2 class="text-xl font-medium tracking-tight">Currently</h2>
              <ul class="mt-4 space-y-3">
                {current.map(({ title, place, since }) => (
                  <li class="border border-edge bg-surface px-4 py-3">
                    <p class="leading-snug font-medium">{title}</p>
                    <p class="mt-0.5 text-sm leading-snug text-subtle">
                      {place}, since {year(since)}
                    </p>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          news.length > 0 && (
            <section id="news">
              <h2 class="text-xl font-medium tracking-tight">News</h2>
              <ol class="mt-4 space-y-3">
                {news.slice(0, 5).map(({ data }) => (
                  <li class="border-l-2 border-accent pl-3">
                    <time
                      datetime={data.date.toISOString()}
                      class="block text-sm text-subtle"
                    >
                      {monthYear(data.date)}
                    </time>
                    <p class="leading-snug">{data.text}</p>
                  </li>
                ))}
              </ol>
            </section>
          )
        }
      </aside>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  /* Keep the chart out from behind the text: it fades in towards the east. */
  #hero :global(.chart) {
    mask-image: linear-gradient(to right, transparent 35%, black 80%);
  }

  /* On narrow screens show only the eastern half of the chart, where the deep low is. */
  @media (max-width: 767px) {
    #hero :global(.chart) {
      left: auto;
      width: 200%;
      mask-image: linear-gradient(to bottom, black, transparent 55%);
      opacity: 0.8;
    }
  }
</style>
