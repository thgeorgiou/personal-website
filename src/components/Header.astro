---
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import { SITE } from "@/config";

// The blog, tags and archives pages still exist; add them back here when the blog returns.
const NAV = [{ href: "/cv", label: "CV" }];

const { pathname } = Astro.url;
const firstSegment = (path: string) => path.split("/").filter(Boolean)[0];
const isActive = (path: string) =>
  firstSegment(pathname) === firstSegment(path);
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
>
  Skip to content
</a>

<header class="app-layout">
  <div class="flex items-center justify-between gap-4 py-5 sm:py-7">
    <a href="/" class="font-display text-lg font-semibold tracking-tight">
      {SITE.title}
    </a>
    <nav class="flex items-center gap-5 sm:gap-7">
      <ul class="flex items-center gap-5 font-display sm:gap-7">
        {
          NAV.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class:list={[
                  "py-1 hover:text-accent-ink",
                  { "active-nav": isActive(href) },
                ]}
                aria-current={isActive(href) ? "page" : undefined}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
      {
        SITE.lightAndDarkMode && (
          <button
            id="theme-btn"
            class="relative size-9 rounded-full hover:bg-surface hover:[&>svg]:stroke-accent"
            title="Toggles light & dark"
            aria-label="auto"
            aria-live="polite"
          >
            <IconMoon class="absolute top-[50%] left-[50%] size-5 -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
            <IconSunHigh class="absolute top-[50%] left-[50%] size-5 -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
          </button>
        )
      }
    </nav>
  </div>
</header>
