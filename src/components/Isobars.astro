---
/**
 * The pressure chart behind the home page hero (see utils/isobars). Computed at
 * build time, so the page ships a static SVG.
 */
import { isobars, markers, viewBox } from "@/utils/isobars";

type Props = { class?: string };
const { class: className } = Astro.props;
---

<svg
  class:list={["isobars", className]}
  viewBox={`${viewBox.x} ${viewBox.y} ${viewBox.width} ${viewBox.height}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  {isobars.map(({ major, d }) => <path d={d} class:list={{ major }} />)}
  {
    markers.map(s => (
      <g class:list={[s.kind === "L" ? "low" : "high"]}>
        <text x={s.x} y={s.y} class="letter">
          {s.kind}
        </text>
        <text x={s.x} y={s.y + 6.5} class="centre">
          {s.centre}
        </text>
      </g>
    ))
  }
</svg>

<style>
  .isobars {
    display: block;
    width: 100%;
    height: 100%;
  }

  path {
    fill: none;
    stroke: var(--isobar);
    stroke-width: 1;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  path.major {
    stroke-width: 1.75;
  }

  /* A halo in the panel colour keeps isobars from running through the labels */
  text {
    font-family: var(--font-display);
    text-anchor: middle;
    dominant-baseline: central;
    stroke: var(--surface);
    stroke-width: 3px;
    stroke-linejoin: round;
    paint-order: stroke;
  }

  .letter {
    font-size: 7px;
    font-weight: 600;
  }

  .centre {
    font-size: 3.2px;
    font-weight: 500;
  }

  .low {
    fill: var(--accent);
  }

  .high {
    fill: var(--isobar);
  }

  /* Weather moves west to east: reveal the chart the same way, once. */
  @media (prefers-reduced-motion: no-preference) {
    .isobars {
      animation: sweep 1.8s cubic-bezier(0.3, 0.6, 0.2, 1) both;
    }

    @keyframes sweep {
      from {
        clip-path: inset(0 100% 0 0);
      }
      to {
        clip-path: inset(0 0 0 0);
      }
    }
  }
</style>
