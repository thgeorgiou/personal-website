---
/**
 * Toggle that hides non-first-author entries in the enclosing Section.
 * Pure CSS: entries/placeholders react via `group-has-checked/section:`,
 * so it works without JavaScript.
 */
---

<label
  class="inline-flex cursor-pointer items-center gap-2 font-display text-sm text-subtle select-none hover:text-foreground"
>
  <input type="checkbox" class="peer sr-only" />
  <span
    aria-hidden="true"
    class="relative h-4 w-7 rounded-full border border-edge bg-surface transition-colors peer-checked:border-accent peer-checked:bg-accent peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-accent peer-focus-visible:outline-dashed after:absolute after:top-1/2 after:left-0.5 after:size-2.5 after:-translate-y-1/2 after:rounded-full after:bg-subtle after:transition-transform peer-checked:after:translate-x-3 peer-checked:after:bg-background"
  ></span>
  First author only
</label>
